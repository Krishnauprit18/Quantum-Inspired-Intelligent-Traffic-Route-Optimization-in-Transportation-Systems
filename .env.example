# Development defaults. Never commit a real .env file.
QUANTROUTE_ENV=development
QUANTROUTE_AUTH_ENABLED=false
QUANTROUTE_API_KEY=replace-with-at-least-32-random-characters
QUANTROUTE_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
QUANTROUTE_CORS_ORIGINS=
QUANTROUTE_MAX_REQUEST_BYTES=2097152
QUANTROUTE_DOCS_ENABLED=true
QUANTROUTE_LOG_LEVEL=INFO
QUANTROUTE_HOST=127.0.0.1
QUANTROUTE_PORT=8000
QUANTROUTE_FORWARDED_ALLOW_IPS=127.0.0.1
